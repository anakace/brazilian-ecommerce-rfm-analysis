    {
      "cell_type": "code",
      "source": [
        "# Assign Recency scores (R_code) from 5 to 1.\n",
        "# The most recent 20% of customers receive a score of 5,\n",
        "# while the least recent 20% receive a score of 1.\n",
        "\n",
        "recency_list['R_code'] = pd.qcut(\n",
        "    recency_list['recency'],\n",
        "    q = 5,\n",
        "    labels = [5, 4, 3, 2, 1]\n",
        ")\n",
        "recency_list"
      ],
